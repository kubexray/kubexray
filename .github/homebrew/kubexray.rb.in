# Generated by .github/workflows/homebrew.yml from the release's checksums.
cask "kubexray" do
  version "@VERSION@"
  name "kubexray"
  desc "Flight recorder for your Kubernetes cluster"
  homepage "https://github.com/kubexray/kubexray"

  on_macos do
    on_intel do
      url "https://github.com/kubexray/kubexray/releases/download/v#{version}/kubexray_#{version}_darwin_amd64.tar.gz"
      sha256 "@SHA_DARWIN_AMD64@"
    end
    on_arm do
      url "https://github.com/kubexray/kubexray/releases/download/v#{version}/kubexray_#{version}_darwin_arm64.tar.gz"
      sha256 "@SHA_DARWIN_ARM64@"
    end
  end
  on_linux do
    on_intel do
      url "https://github.com/kubexray/kubexray/releases/download/v#{version}/kubexray_#{version}_linux_amd64.tar.gz"
      sha256 "@SHA_LINUX_AMD64@"
    end
    on_arm do
      url "https://github.com/kubexray/kubexray/releases/download/v#{version}/kubexray_#{version}_linux_arm64.tar.gz"
      sha256 "@SHA_LINUX_ARM64@"
    end
  end

  binary "kubexray"

  # Not notarized by Apple: clear the quarantine flag macOS sets on downloads.
  postflight do
    if system_command("/usr/bin/xattr", args: ["-h"]).exit_status == 0
      system_command "/usr/bin/xattr", args: ["-dr", "com.apple.quarantine", "#{staged_path}/kubexray"]
    end
  end
end
